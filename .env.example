# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Streaming & Heartbeat
WS_HEARTBEAT_INTERVAL=1.0

# Optional Kafka Broker (Only needed if running external Kafka broker)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
